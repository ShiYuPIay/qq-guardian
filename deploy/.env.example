# Copy this file to deploy/.env. Do not commit .env: it contains secrets.

# Pin this to a reviewed SnowLuma release in production instead of :latest.
SNOWLUMA_IMAGE=motricseven7/snowluma:latest
GUARDIAN_IMAGE=qq-guardian:local
TZ=Asia/Shanghai

# Use a unique, long value. This protects the noVNC desktop login.
VNC_PASSWD=replace-with-a-long-unique-password

# SnowLuma generates an accessToken in its OneBot configuration on first boot.
# After configuring its Universal wsServer, paste that exact token here and
# recreate only the Guardian service. Leave empty for the initial SnowLuma boot.
SNOWLUMA_ACCESS_TOKEN=
# Preferred provider transport. Alternatives: http, reverse-websocket.
SNOWLUMA_TRANSPORT=forward-websocket
SNOWLUMA_HTTP_URL=http://snowluma:3000/
SNOWLUMA_WEBHOOK_HOST=0.0.0.0
SNOWLUMA_WEBHOOK_PORT=6100
SNOWLUMA_WEBHOOK_PATH=/onebot/events
SNOWLUMA_REVERSE_WS_HOST=0.0.0.0
SNOWLUMA_REVERSE_WS_PORT=6101
SNOWLUMA_REVERSE_WS_PATH=/onebot

# Optional unattended first-admin bootstrap, used only while the users table
# is empty. Keep both values in this untracked .env or a secret; never commit them.
# QQ_GUARDIAN_BOOTSTRAP_USERNAME=guardian-admin
# QQ_GUARDIAN_BOOTSTRAP_PASSWORD=replace-with-a-unique-12-plus-character-password
# Break-glass recovery only: set to 1 for one start together with both explicit
# bootstrap values. Missing/invalid values abort startup without recovery.
# Verify the audit, then remove all three values.
# QQ_GUARDIAN_FORCE_BOOTSTRAP_RECOVERY=1

# The following default is for the snowluma service in this Compose file.
# For a separately deployed SnowLuma, use an explicitly reachable endpoint.
# If that endpoint crosses an untrusted network, terminate TLS there and use
# wss:// instead of ws://; the bundled sidecar default stays on private Docker DNS.
SNOWLUMA_WS_URL=ws://snowluma:3001/

# Guardian tries its native WebSocket client first. `auto` enables the bundled
# official SDK WebSocket fallback only when native startup exhausts its retries.
# Use `off` only when diagnosing a transport incompatibility.
SNOWLUMA_SDK_FALLBACK=auto

# Native WebSocket ingress limits. The active frame counts toward both queue
# limits; oversized frames close the connection with WebSocket code 1009.
SNOWLUMA_MAX_FRAME_BYTES=1048576
SNOWLUMA_RAW_QUEUE_LIMIT=64
SNOWLUMA_RAW_QUEUE_BYTES=8388608

# DANGEROUS OVERRIDE — disabled by default. Setting the literal value `true`
# deliberately permits custom AI requests to private-network addresses AND
# plaintext HTTP, relaxing Guardian's normal SSRF/transport protections.
# Use only for a trusted local OpenAI-compatible endpoint on a network you
# control. Guardian emits a startup warning whenever this override is active.
# The base Compose file intentionally does not pass it; use an untracked local
# override only when this risk is explicitly accepted.
# QQ_GUARDIAN_ALLOW_PRIVATE_AI_ENDPOINTS=true

# All host mappings are loopback-only in compose.yaml. Never publish the raw
# Guardian HTTP port publicly. For public WebUI/API access, set a DNS name below
# and add deploy/compose.https.yaml; Caddy owns public 80/443 and proxies to the
# private Compose service name `guardian:6099`.
NOVNC_HOST_PORT=6081
SNOWLUMA_WEBUI_HOST_PORT=5099
GUARDIAN_HTTP_HOST_PORT=6099
# GUARDIAN_DOMAIN=guardian.example.com
GUARDIAN_HTTP_REDIRECT_HOST_PORT=80
GUARDIAN_HTTPS_HOST_PORT=443

# Keep these names unchanged across `docker compose up`, image upgrades, and
# panel redeployments. `docker compose down -v` deliberately destroys them.
SNOWLUMA_DATA_VOLUME=qq-guardian-snowluma-data
QQ_CLIENT_CONFIG_VOLUME=qq-guardian-qq-config
QQ_CLIENT_DATA_VOLUME=qq-guardian-qq-data
GUARDIAN_DATA_VOLUME=qq-guardian-data
GUARDIAN_CONFIG_VOLUME=qq-guardian-config
GUARDIAN_CADDY_DATA_VOLUME=qq-guardian-caddy-data
GUARDIAN_CADDY_CONFIG_VOLUME=qq-guardian-caddy-config
